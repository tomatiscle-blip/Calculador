# --- Entorno de Python ---
.venv/
venv/
__pycache__/
*.py[cod]

# --- Visual Studio / VS Code ---
.vs/
.vscode/

# --- Copias de respaldo de la app ---
*.bak
*.tmp

# --- Red de seguridad de pruebas (copias locales de resultados, no versionar) ---
tests/golden/
tests/_tmp/

# --- Bibliografía: los JSON de datos sí se versionan; los PDF (reglamentos,
# tablas) son pesados y se bajan por separado, no van al repo. ---
Bibliografia/*.pdf
Bibliografia/*.PDF

# --- Temporales de prueba del proyecto ---
_repro*.py
_verif*.txt
_gs*.txt
_git_*.txt
_tmp_*.txt
_tmp_*.json
tools/_tmp_*
tests/_tmp_*.txt
# --- Salidas generadas por obra (se recalculan, no se versionan) ---
Obras/*/salidas/
